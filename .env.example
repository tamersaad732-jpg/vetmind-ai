# ==============================================================================
# VetMind AI & VetBook - Environment Variables Template (.env.example)
# ==============================================================================
# تعليمات الإعداد للمبتدئين:
# 1. انسخ هذا الملف وسمِّ النسخة الجديدة: .env
# 2. املأ القيم الخاصة بك أدناه (جميع القيم الحالية هي أمثلة توضيحية فقط ولا تحتوي على أسرار حقيقية).
# 3. عند النشر على Vercel، أضف هذه المتغيرات في: Project Settings -> Environment Variables.
# ==============================================================================

# 1. إعدادات التطبيق وتأمين الجلسات (Application & Session Security)
SESSION_SECRET=YOUR_SECURE_RANDOM_SESSION_SECRET_KEY_HERE
PORT=7860
# VERCEL=1

# 2. قاعدة البيانات السحابية المجانية الدائمة (Permanent Free Cloud Database)
# الخيار أ (الموصى به): Neon Serverless PostgreSQL (مجاني تماماً بدون بطاقة بنكية - 0.5 GB تخزين)
# التسجيل من: https://neon.tech
# DATABASE_URL=postgresql://user:password@ep-project-name.region.aws.neon.tech/neondb?sslmode=require
#
# الخيار ب: Turso Serverless SQLite / LibSQL (مجاني تماماً بدون بطاقة بنكية - 5 GB تخزين)
# التسجيل من: https://turso.tech
# TURSO_DATABASE_URL=libsql://your-db-name-your-username.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here

# 3. تخزين الصور والوسائط السحابي المجاني (Optional Cloud Media Storage)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 4. محرك الذكاء الاصطناعي السريري (Groq AI Clinical Consultation)
GROQ_API_KEY=your_groq_api_key_here

# 5. خدمة البريد الإلكتروني والـ OTP (Optional Email Verification)
RESEND_API_KEY=your_resend_api_key_here
SMTP_FROM=VetMind AI <notifications@vetmind.ai>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here

# 6. خدمة الرسائل النصية (Optional SMS Gateway)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
SMS_GATEWAY_URL=https://your-sms-gateway.com/api/send
SMS_API_KEY=your_sms_gateway_api_key
SMS_SENDER_ID=VetMind
